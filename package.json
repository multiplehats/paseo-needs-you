{
  "name": "paseo-needs-you",
  "private": true,
  "version": "0.1.1",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "assets/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "oxlint index.client.tsx index.server.ts client server shared tests",
    "format": "oxfmt index.client.tsx index.server.ts client server shared tests",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "description": "A sidebar list of every Paseo agent that needs you: open questions, permission prompts and failures.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multiplehats/paseo-needs-you.git"
  },
  "homepage": "https://github.com/multiplehats/paseo-needs-you",
  "bugs": {
    "url": "https://github.com/multiplehats/paseo-needs-you/issues"
  }
